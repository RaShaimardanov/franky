# Токен от @BotFather. В BotFather также включите inline-режим: /setinline
BOT__TOKEN=123456:ABC-DEF
# Чат, куда команда `franky upload` заранее заливает аудио (получение file_id).
# Например, ваш личный id или закрытый канал, где бот — админ.
BOT__STORAGE_CHAT_ID=
# Свой Bot API сервер, если файлы больше 50 МБ: http://telegram-bot-api:8081
# BOT__API_SERVER=

# Пароль Postgres для docker compose (в Coolify — сгенерируйте в UI).
POSTGRES_PASSWORD=change-me
# Для запуска без Docker (`uv run franky bot`); в compose собирается автоматически.
DB__DSN=postgresql+asyncpg://franky:change-me@localhost:5432/franky

GAME__MAX_ATTEMPTS=3
GAME__MAX_HINTS=2

LOG_LEVEL=INFO
LOG_JSON=false
